# ===========================================
# AI Hub — Environment Variables
# انسخ الملف إلى .env واملأ القيم الحقيقية:
#   copy .env.example .env
# ===========================================

# --- LiteLLM Admin ---
# مفتاح الإدارة (Admin UI + إنشاء Teams/Keys)
# غيّره لقيمة عشوائية قوية قبل أي استخدام حقيقي
LITELLM_MASTER_KEY=sk-aihub-change-me-master

# يشفّر مفاتيح المزودين في قاعدة البيانات — لا تغيّره بعد إضافة Models
# ولّد قيمة عشوائية مرة واحدة واحفظها بأمان
LITELLM_SALT_KEY=sk-aihub-change-me-salt

# --- PostgreSQL ---
POSTGRES_PASSWORD=aihub_change_me_db_password

# --- مزودو الذكاء الاصطناعي (المفاتيح الحقيقية — لا تُشارك مع المشاريع) ---
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# اختياري — مزودين إضافيين لاحقًا
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
