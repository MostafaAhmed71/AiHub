# Environment template for AI Hub
# Copy to .env and fill real secrets. Never commit real keys.

# --- Postgres ---
POSTGRES_USER=aihub
POSTGRES_PASSWORD=aihub_secret_change_me
POSTGRES_DB=aihub
POSTGRES_PORT=5432

# --- LiteLLM ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-aihub-master-change-me
LITELLM_SALT_KEY=aihub-salt-change-me-to-long-random

# Real provider keys (stored only here / secrets manager — never in client apps)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- RAG Service ---
RAG_SERVICE_PORT=8000
# LiteLLM Virtual Key used BY the RAG service to call embeddings/chat
RAG_SERVICE_VIRTUAL_KEY=sk-rag-service-change-me
# API key clients must send as header: X-API-Key (protects /rag/* and /prompts/*)
RAG_SERVICE_API_KEY=change-me-generate-a-long-random-string
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gemini/gemini-2.0-flash
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CORS_ORIGINS=*
